# Secret local configuration. Copy config.example.php to config.php when deploying.
/config.php
/deploy.credentials.json
/sftp-config.json

# Generated static-map responses. The directory itself is kept for deployment.
/cache/*
!/cache/.gitkeep

# Capturas PNG originales para inspección visual. Se crean por solicitud y no
# deben subirse al repositorio.
/public/images/*
!/public/images/.gitkeep
